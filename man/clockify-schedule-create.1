.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-schedule-create - Create a schedule assignment


.SH SYNOPSIS
\fBclockify schedule create [flags]\fP


.SH DESCRIPTION
Create a schedule assignment


.SH OPTIONS
\fB--billable\fP[=false]
	assignment is billable

.PP
\fB--duration\fP=""
	alias for --hours-per-day (e.g. 8h)

.PP
\fB--end\fP=""
	assignment end date (required)

.PP
\fB--file\fP=""
	JSON file with assignment data

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--hours-per-day\fP=""
	hours per day (e.g. 8 or 8h)

.PP
\fB--note\fP=""
	assignment note

.PP
\fB--project\fP=""
	project ID or name (required)

.PP
\fB--start\fP=""
	assignment start date (required)

.PP
\fB--stdin\fP[=false]
	read assignment data from stdin

.PP
\fB--user\fP=""
	user ID, email, or name (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-schedule(1)\fP
