.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-project-update - Update a project


.SH SYNOPSIS
\fBclockify project update [flags]\fP


.SH DESCRIPTION
Update a project


.SH OPTIONS
\fB--archive\fP[=false]
	archive the project

.PP
\fB--billable\fP[=false]
	project is billable

.PP
\fB--client\fP=""
	client ID

.PP
\fB--color\fP=""
	project color (hex format: #RRGGBB)

.PP
\fB--file\fP=""
	JSON file with project data

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--id\fP=""
	project ID

.PP
\fB--name\fP=""
	project name (fuzzy match)

.PP
\fB--new-name\fP=""
	new project name

.PP
\fB--note\fP=""
	project note

.PP
\fB--stdin\fP[=false]
	read project data from stdin


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-project(1)\fP
