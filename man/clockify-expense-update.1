.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-expense-update - Update an expense


.SH SYNOPSIS
\fBclockify expense update [flags]\fP


.SH DESCRIPTION
Update an expense


.SH OPTIONS
\fB--amount\fP=""
	new amount

.PP
\fB--category\fP=""
	new category ID or name

.PP
\fB--date\fP=""
	new date YYYY-MM-DD or relative

.PP
\fB--description\fP=""
	new notes

.PP
\fB--file\fP=""
	JSON file with update data

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--id\fP=""
	expense ID

.PP
\fB--stdin\fP[=false]
	read update data from stdin

.PP
\fB--type\fP=""
	new expense type/category name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-expense(1)\fP
