.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-time-entry-update - Update one or more time entries


.SH SYNOPSIS
\fBclockify time-entry update [id|current|last] [id...] [flags]\fP


.SH DESCRIPTION
Update one or more time entries


.SH OPTIONS
\fB--billable\fP[=false]
	mark as billable

.PP
\fB--description\fP=""
	description

.PP
\fB--duration\fP=""
	duration (e.g., 1h, 30m, 1h30m)

.PP
\fB--end\fP=""
	end time (same formats as --start)

.PP
\fB--file\fP=""
	JSON file with time entry data

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--id\fP=""
	time entry ID, current, or last

.PP
\fB--project\fP=""
	project ID or name

.PP
\fB--start\fP=""
	start time (RFC3339, YYYY-MM-DD, HH:MM, now, ±offsets, or relative date)

.PP
\fB--stdin\fP[=false]
	read time entry data from stdin

.PP
\fB--stdin-ids\fP[=false]
	read time entry IDs from stdin (one per line or JSON array)

.PP
\fB--tags\fP=""
	tag IDs or names (comma-separated)

.PP
\fB--task\fP=""
	task ID or name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-time-entry(1)\fP
