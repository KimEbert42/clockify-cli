.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-custom-field - Manage custom fields


.SH SYNOPSIS
\fBclockify custom-field [flags]\fP


.SH DESCRIPTION
List, create, update, and delete Clockify workspace custom fields.

.PP
Supported types (CLI names → API):
  TEXT→TXT, NUMBER, DROPDOWN→DROPDOWN_SINGLE, DROPDOWN_SINGLE, DROPDOWN_MULTIPLE, CHECKBOX, LINK
  DATE is not supported by the Clockify API.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for custom-field


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify(1)\fP, \fBclockify-custom-field-create(1)\fP, \fBclockify-custom-field-delete(1)\fP, \fBclockify-custom-field-list(1)\fP, \fBclockify-custom-field-update(1)\fP
