.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-time-entry-list - List time entries


.SH SYNOPSIS
\fBclockify time-entry list [flags]\fP


.SH DESCRIPTION
List time entries


.SH OPTIONS
\fB--description\fP=""
	search by description

.PP
\fB--end\fP=""
	end date (same formats as --start)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--hydrated\fP[=false]
	include full project/task/user objects in output

.PP
\fB--in-progress\fP[=false]
	show only running timers

.PP
\fB--project\fP=""
	filter by project ID or name

.PP
\fB--start\fP=""
	start date (YYYY-MM-DD, HH:MM, relative: today, yesterday, this-week, last-week, this-month, last-month, or RFC3339)

.PP
\fB--tags\fP=""
	filter by tag IDs or names (comma-separated)

.PP
\fB--task\fP=""
	filter by task ID or name (requires --project)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-time-entry(1)\fP
