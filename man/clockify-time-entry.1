.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-time-entry - Manage time entries


.SH SYNOPSIS
\fBclockify time-entry [flags]\fP


.SH DESCRIPTION
List, get, create, update, and delete Clockify time entries.

.PP
Selectors for get/update/delete/stop/clone/split:
       time entry UUID
  current  the running timer
  last     most recent completed entry


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for time-entry


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify(1)\fP, \fBclockify-time-entry-bulk(1)\fP, \fBclockify-time-entry-clone(1)\fP, \fBclockify-time-entry-create(1)\fP, \fBclockify-time-entry-delete(1)\fP, \fBclockify-time-entry-get(1)\fP, \fBclockify-time-entry-list(1)\fP, \fBclockify-time-entry-split(1)\fP, \fBclockify-time-entry-start(1)\fP, \fBclockify-time-entry-stop(1)\fP, \fBclockify-time-entry-update(1)\fP
