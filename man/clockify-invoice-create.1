.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-invoice-create - Create an invoice


.SH SYNOPSIS
\fBclockify invoice create [flags]\fP


.SH DESCRIPTION
Create an invoice


.SH OPTIONS
\fB--client\fP=""
	client ID or name (required)

.PP
\fB--currency\fP=""
	currency code e.g. USD (required)

.PP
\fB--end\fP=""
	due date YYYY-MM-DD or relative (required)

.PP
\fB--file\fP=""
	JSON file with invoice data

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--note\fP=""
	invoice note

.PP
\fB--number\fP=""
	invoice number (auto-generated if omitted)

.PP
\fB--start\fP=""
	issued date YYYY-MM-DD or relative (required)

.PP
\fB--status\fP=""
	invoice status

.PP
\fB--stdin\fP[=false]
	read invoice data from stdin


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-invoice(1)\fP
