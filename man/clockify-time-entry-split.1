.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-time-entry-split - Split a time entry at one or more times


.SH SYNOPSIS
\fBclockify time-entry split  --at HH:MM [--at HH:MM...] [flags]\fP


.SH DESCRIPTION
Divide an entry at the given local times. The original entry ends at the
first split point; remaining segments are created with identical metadata.
Split points must fall strictly inside the entry.


.SH OPTIONS
\fB--at\fP=[]
	split point (HH:MM or full timestamp; repeatable)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompt

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for split


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-time-entry(1)\fP
