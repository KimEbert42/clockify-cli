.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-approval-submit - Submit an approval request for a period


.SH SYNOPSIS
\fBclockify approval submit [flags]\fP


.SH DESCRIPTION
Submit a period-based approval request.

.PP
Official API model: POST /approval-requests/{type} with period + periodStart.
Per-time-entry submission (--time-entry) is not supported by the official API.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for submit

.PP
\fB--note\fP=""
	submission note

.PP
\fB--period\fP=""
	WEEKLY or MONTHLY (required)

.PP
\fB--start\fP=""
	period start date (required)

.PP
\fB--time-entry\fP=""
	unsupported (official API uses period-based submission)

.PP
\fB--type\fP=""
	TIMESHEET, EXPENSE, or TIMESHEET_AND_EXPENSE (default TIMESHEET)

.PP
\fB--user\fP=""
	submit on behalf of user ID, email, or name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-approval(1)\fP
