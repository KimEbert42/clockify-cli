.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-report - Generate time reports


.SH SYNOPSIS
\fBclockify report [flags]\fP


.SH DESCRIPTION
Generate Clockify summary, detailed, and weekly reports.

.PP
Reports use the Clockify Reports API (separate host/path from the main API).
Date shortcuts: today, yesterday, this-week, last-week, this-month, last-month.

.PP
Presets (summary with matching date range):
  report today|yesterday|this-week|last-week|this-month|last-month


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for report


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--confirm\fP[=false]
	skip confirmation prompts

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify(1)\fP, \fBclockify-report-detailed(1)\fP, \fBclockify-report-last-month(1)\fP, \fBclockify-report-last-week(1)\fP, \fBclockify-report-summary(1)\fP, \fBclockify-report-this-month(1)\fP, \fBclockify-report-this-week(1)\fP, \fBclockify-report-today(1)\fP, \fBclockify-report-weekly(1)\fP, \fBclockify-report-yesterday(1)\fP
