.nh
.TH "CLOCKIFY" "1" "Oct 2026" "clockify-cli" ""

.SH NAME
clockify-time-off-delete - Delete a time-off request


.SH SYNOPSIS
\fBclockify time-off delete [flags]\fP


.SH DESCRIPTION
Delete a time-off request


.SH OPTIONS
\fB--confirm\fP[=false]
	skip confirmation prompt

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for delete

.PP
\fB--id\fP=""
	time-off request ID

.PP
\fB--policy\fP=""
	policy ID or name (required)

.PP
\fB--type\fP=""
	time-off type label used to resolve a policy


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Clockify API key (overrides config)

.PP
\fB--no-cache\fP[=false]
	bypass local cache and fetch fresh data

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-pagination\fP[=false]
	fetch all pages automatically

.PP
\fB--output\fP=""
	output format: table, json, csv, yaml, template, ids (default: auto-detect)

.PP
\fB--page\fP=1
	page number for paginated results

.PP
\fB--page-size\fP=50
	number of items per page

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--region\fP=""
	API region: global, eu-de, us, uk, au

.PP
\fB--template\fP=""
	template string for --output template (Go text/template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose output (can be repeated for debug)

.PP
\fB--workspace\fP=""
	workspace ID or name


.SH SEE ALSO
\fBclockify-time-off(1)\fP
